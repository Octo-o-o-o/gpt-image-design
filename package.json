{
  "name": "gpt-image-design",
  "version": "0.3.3",
  "description": "在 DSH 中用 ChatGPT Pro 网页会话或任意 OpenAI 兼容生图 API 出设计图与单文件 HTML demo；图片和代码保存到本地，侧边栏画廊预览、iframe 打开。Generate images and HTML demos via a real ChatGPT Pro web session or an OpenAI-compatible image API, saved locally with a gallery in DSH.",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "resources",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "chatgpt",
    "image-generation",
    "openai-compatible",
    "image-api",
    "design",
    "browser-automation",
    "cordis"
  ],
  "author": "Octo-o-o-o",
  "license": "MIT",
  "homepage": "https://github.com/Octo-o-o-o/gpt-image-design#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Octo-o-o-o/gpt-image-design.git"
  },
  "bugs": {
    "url": "https://github.com/Octo-o-o-o/gpt-image-design/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "playwright-core": "^1.64.1"
  }
}
